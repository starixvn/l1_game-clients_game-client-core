{
    "testEnvironment": "jsdom",
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [],
    "transform": {
        "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    },
    "testPathIgnorePatterns": ["/node_modules/"],
    "testMatch": ["**/?(*.)+(spec|test).+(ts)"],
    "testResultsProcessor": "jest-sonar-reporter",
    "coverageReporters": ["cobertura", "text-summary", "text", "lcov"],
    "setupFiles": ["<rootDir>/tests/cocos-testing/reflect-metadata.ts"],
    "reporters": [
        "default",
        [
            "jest-junit",
            {
                "outputDirectory": "coverage"
            }
        ]
    ],
    "verbose": true,
    "moduleNameMapper": {
        "cc": "<rootDir>/tests/cocos-testing/cc",
        "^observer": "<rootDir>/tests/cocos-testing/observer",
        "mobx": "<rootDir>/tests/cocos-testing/mobx",
        "inversify": "<rootDir>/tests/cocos-testing/inversify",
        "db://shared-components/(.*)": "<rootDir>/extensions/shared-components/assets/$1",
        "db://i18n/(.*)": "<rootDir>/extensions/i18n/assets/$1"
    }
}
