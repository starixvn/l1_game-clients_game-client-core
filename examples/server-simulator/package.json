{
    "name": "server-simulator",
    "version": "1.0.0",
    "scripts": {
        "run-docker-compose": "ts-node --script-mode src/docker-compose.ts ",
        "install-sedie-dependency": "cd ../sedie-service && yarn install",
        "mock-sedie-service": "cd ../sedie-service && npm run mock-service",
        "mock-user-service": "nodemon src/server.ts ",
        "start": "concurrently -c \"auto\" \"npm run mock-user-service\" \"npm run mock-sedie-service\"",
        "install-then-start": "npm install && npm run start",
        "test": "echo \"Error: no test specified\" && exit 1",
        "start-docker": "node build/server.js",
        "tsc": "tsc",
        "build": "tsc"
    },
    "dependencies": {
        "cors": "2.8.5",
        "docker-compose": "^0.23.19",
        "express": "^4.18.1",
        "game-client-base": "file:../..",
        "nodemon": "2.0.22",
        "socket.io": "4.6.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.13",
        "@types/node": "18.15.11",
        "concurrently": "^8.0.1",
        "typescript": "^4.7.4"
    }
}
