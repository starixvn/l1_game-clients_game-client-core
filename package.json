{
  "name": "game-client-base",
  "version": "0.0.0",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "license": "UNLICENSED",
  "files": [
    "dist/"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./umd": "./dist/game-client-base.js",
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && webpack",
    "start:dev": "nodemon ./src/startup-dev.ts",
    "start:dev-dist": "nodemon ./dist/startup-dev.js",
    "start:dev-server": "nodemon ./demo/game-service/server.js",
    "test-coverage": "jest",
    "test-demo": "node ./demo/test.js",
    "reg": "npm set registry http://npm.lumigame.com"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "eventemitter2": "6.4.9",
    "inversify": "6.0.1",
    "socket.io-client": "4.6.0",
    "ts-simple-nameof": "^1.3.1"
  },
  "devDependencies": {
    "@types/jest": "29.4.0",
    "@types/node": "18.13.0",
    "cron": "^2.3.0",
    "express": "^4.18.2",
    "jest": "29.4.3",
    "jest-junit": "15.0.0",
    "jest-sonar-reporter": "2.0.0",
    "mobx": "^6.8.0",
    "nodemon": "2.0.20",
    "reflect-metadata": "0.1.13",
    "socket.io": "^4.6.1",
    "ts-jest": "29.0.5",
    "ts-loader": "9.4.2",
    "ts-node": "10.9.1",
    "typescript": "4.9.5",
    "webpack": "5.75.0",
    "webpack-cli": "5.0.1"
  }
}
