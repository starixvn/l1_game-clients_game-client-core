{
    "name": "game-client-base",
    "version": "0.0.0",
    "type": "commonjs",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "license": "UNLICENSED",
    "files": [
        "dist/"
    ],
    "scripts": {
        "start": "tsc --watch",
        "build": "tsc",
        "test": "jest unit-tests",
        "integration-test": "jest integration-tests/index.test.ts",
        "test-coverage": "jest unit-tests --collect-coverage",
        "posttest-coverage-with-cocos": "npm run build && cd examples/cocos-3x && npm install && npm run test",
        "test:watch": "jest --watch --verbose",
        "reg": "npm set registry http://npm.lumigame.com",
        "start-simulator": "docker compose -f \"examples/server-simulator/docker-compose.yml\" up -d --build"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "base64-string": "^1.1.2",
        "eventemitter2": "6.4.9",
        "inversify": "6.0.1",
        "lodash": "^4.17.21",
        "sc-user-service-client": "1.5.1-beta.7",
        "socket.io-client": "4.6.1",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@types/jest": "29.5.0",
        "@types/socket.io-client": "^3.0.0",
        "jest": "29.5.0",
        "jest-auto-stub": "^1.0.8",
        "jest-environment-jsdom": "^29.5.0",
        "jest-junit": "15.0.0",
        "jest-sonar-reporter": "2.0.0",
        "mobx": "6.9.0",
        "prettier": "2.8.7",
        "reflect-metadata": "0.1.13",
        "socket.io-mock-ts": "^1.0.2",
        "ts-jest": "29.1.0",
        "ts-node": "10.9.1",
        "typescript": "5.0.4"
    }
}
